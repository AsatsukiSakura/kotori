# osu! API v2 凭证 (https://osu.ppy.sh/home/account/edit#oauth)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# KanonBot WebSocket 地址 (公网可用)
KANONBOT_WS_URL=ws://botws.desu.life:65000
KANONBOT_SELF_ID=10001
KANONBOT_TEST_USER=10002

# NapCat HTTP API 地址 (kotori 用这个发消息到 QQ)
NAPCAT_API=http://127.0.0.1:3000
# NapCat HTTP 服务器的 token（填 NapCat WebUI 里 HTTP 服务器设置的令牌；留空 = NapCat 那边也不设 token）
NAPCAT_TOKEN=

# NapCat/LLOneBot 的 WebSocket 地址 (NapCat 用这个推送事件给 kotori)
OBT_WS_URL=ws://127.0.0.1:3001
OBT_SELF_ID=

# 启动公告：首次连上 NapCat 时主动发一条到该群（群号留空则不发送）
# ANNOUNCE_GROUP_ID=787635973
# ANNOUNCE_MESSAGE=该吃补佳乐了!
# 启动公告同时 @ 某个人（填对方 QQ 号，留空则不 @）
# ANNOUNCE_AT_QQ=2506642658

# 彩蛋：群里有人发送 "npm start" 时回复的内容（文案留空则彩蛋不触发）
EASTER_EGG_MESSAGE=该吃补佳乐了!
# 彩蛋同时 @ 某个人（填对方 QQ 号，留空则不 @）
EASTER_EGG_AT_QQ=